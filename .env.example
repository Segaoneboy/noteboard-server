# ---- Noteboard API ----
PORT=5000

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noteboard?schema=public"

# JWT secrets — сгенерируй свои: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Supabase project (Storage для картинок заметок)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
